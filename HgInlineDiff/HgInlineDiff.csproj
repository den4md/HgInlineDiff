<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <UseWPF>true</UseWPF>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <Version>0.2.2</Version>
    <Product>HgInlineDiff</Product>
    <Description>Mercurial editor markers, Solution Explorer status icons, and a changes window for Visual Studio.</Description>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Images.imagemanifest">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.EditorFeatures.Text" Version="4.0.1" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <VSCTCompile Include="Commands.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\LICENSE.txt;..\THIRD-PARTY-NOTICES.md">
      <Link>%(Filename)%(Extension)</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\assets\logo-90px.png">
      <Link>assets\logo-90px.png</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Resource Include="..\assets\logo-90px.png">
      <Link>assets\logo-90px.png</Link>
    </Resource>
  </ItemGroup>
</Project>
